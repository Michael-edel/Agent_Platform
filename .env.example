# =========================
# OpenAI API (для OCR/документов)
# =========================
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# =========================
# SQLite DB (legacy, для старых компонентов)
# =========================
DB_PATH=inventory.db

# =========================
# Platform Database
# =========================
# SQLite (для dev/local)
PLATFORM_DB_PATH=platform.db

# PostgreSQL (для staging/production)
# Укажите один длинный случайный пароль; DATABASE_URL должен содержать тот же URL-кодированный пароль.
DATABASE_URL=
POSTGRES_DB=agent_platform
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# =========================
# Application
# =========================
APP_PORT=8000
DEBUG=0

# =========================
# API authentication and tenant scopes (required in staging/production)
# =========================
AUTH_ENABLED=true
# JSON: token -> immutable subject, role and allowed tenant IDs. Do not use X-Role for authorization.
API_TOKEN_CONFIG='{"replace-with-long-random-token":{"subject":"pilot-accountant","role":"accountant","tenants":["tenant-1"]}}'

# =========================
# 1C integration (optional)
# =========================
ONEC_BASE_URL=http://localhost:8001/api
ONEC_TOKEN=your-1c-token-here

# =========================
# Telegram bot (optional)
# =========================
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here

# =========================
# Billing
# =========================
BILLING_ENABLED=1
BILLING_DEFAULT_PLAN=plan_free
BILLING_ADMIN_KEY=dev-admin-key

# Stripe (optional)
STRIPE_ENABLED=0
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Kaspi (optional)
KASPI_ENABLED=0
KASPI_API_KEY=
KASPI_MERCHANT_ID=

# =========================
# Agent Executor
# =========================
AGENT_EXECUTOR_ENABLED=true
AGENT_EXECUTOR_POLL_INTERVAL_MS=1000

# =========================
# Demo tenant bootstrap (для локального запуска)
# =========================
DEMO_BOOTSTRAP_ENABLED=true

# =========================
# S3/MinIO Export (optional)
# =========================
S3_EXPORT_ENABLED=0
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=agent-platform
S3_REGION=us-east-1

# =========================
# Observability
# =========================
LOG_LEVEL=INFO
LOG_FORMAT=json
METRICS_ENABLED=1
