{
  "title": "Billing Worker / Jobs",
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "10s",
  "tags": ["billing", "worker"],
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "type": "timeseries",
      "title": "Worker liveness (billing_worker_up)",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [
        { "expr": "sum(billing_worker_up)", "refId": "A" }
      ]
    },
    {
      "type": "stat",
      "title": "Seconds since last successful iteration",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "targets": [
        { "expr": "time() - max(billing_worker_last_success_timestamp)", "refId": "A" }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } }
    },
    {
      "type": "timeseries",
      "title": "Iteration latency p95 (seconds)",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(billing_worker_iteration_duration_seconds_bucket[5m])) by (le))",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Jobs outcomes rate (5m)",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "targets": [
        { "expr": "sum(rate(billing_jobs_processed_total{result=\"succeeded\"}[5m]))", "refId": "A", "legendFormat": "succeeded" },
        { "expr": "sum(rate(billing_jobs_processed_total{result=\"failed\"}[5m]))", "refId": "B", "legendFormat": "failed" },
        { "expr": "sum(rate(billing_jobs_processed_total{result=\"retried\"}[5m]))", "refId": "C", "legendFormat": "retried" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Queue depth",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
      "targets": [
        { "expr": "billing_jobs_queue_depth{status=\"pending\"}", "refId": "A", "legendFormat": "pending" },
        { "expr": "billing_jobs_queue_depth{status=\"pending_retry\"}", "refId": "B", "legendFormat": "pending_retry" },
        { "expr": "billing_jobs_queue_depth{status=\"processing\"}", "refId": "C", "legendFormat": "processing" },
        { "expr": "billing_jobs_queue_depth{status=\"failed\"}", "refId": "D", "legendFormat": "failed" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Retry lag (max overdue, seconds)",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 },
      "targets": [
        { "expr": "billing_jobs_next_attempt_lag_seconds", "refId": "A" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Provider refresh rate (5m)",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "x": 0, "y": 24, "w": 12, "h": 8 },
      "targets": [
        { "expr": "sum(rate(billing_jobs_provider_refresh_total{result=\"ok\"}[5m])) by (provider)", "refId": "A", "legendFormat": "{{provider}} ok" },
        { "expr": "sum(rate(billing_jobs_provider_refresh_total{result=\"error\"}[5m])) by (provider)", "refId": "B", "legendFormat": "{{provider}} error" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Job processing duration p95 (seconds)",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "x": 12, "y": 24, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(billing_job_process_duration_seconds_bucket[5m])) by (le, provider))",
          "refId": "A",
          "legendFormat": "{{provider}} p95"
        }
      ]
    }
  ]
}

